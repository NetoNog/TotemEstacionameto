# ==========================================================
# SMARTPARK TOTEM - CONFIGURAÇÃO DE AMBIENTE DE PRODUÇÃO
# ==========================================================

# 1. Banco de Dados PostgreSQL (Local ou Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/totem_estacionamento?schema=public"

# 2. Identificação do Terminal Totem
NEXT_PUBLIC_APP_NAME="SmartTotem Estacionamento"
NEXT_PUBLIC_TERMINAL_ID="TERM-01"
ADMIN_API_KEY="totem-admin-secret-2026"

# 3. Ponte de Pagamento: PIX Oficial Banco Central (Bacen / EMVco)
# Chave Pix do estabelecimento (CNPJ, CPF, Celular, E-mail ou Chave Aleatória EVP)
PIX_CHAVE="12345678000190"
PIX_BENEFICIARIO="SMARTPARK TOTEM 01"
PIX_CIDADE="SAO PAULO"

# 4. Ponte de Pagamento: TEF / PinPad (Cartão Débito e Crédito)
# Endereço do daemon/serviço local TEF na máquina do totem (Ex: SiTef, PayGo, Stone, PagBank)
TEF_ENDPOINT="http://127.0.0.1:8080/tef"
TEF_TERMINAL_ID="TERM01"
